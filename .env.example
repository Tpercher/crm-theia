# Connexion de l'application : rôle de connexion membre de crm_app,
# jamais superutilisateur ni BYPASSRLS (l'application refuse de démarrer sinon).
DATABASE_URL=postgres://crm_web:motdepasse@localhost:5432/crm

# Connexion propriétaire, utilisée uniquement par `npm run db:migrate`.
MIGRATION_DATABASE_URL=postgres://crm_owner:motdepasse@localhost:5432/crm

# Tests : URL d'un superutilisateur sur un serveur jetable (une base est créée puis supprimée).
TEST_DATABASE_ADMIN_URL=postgres://postgres@localhost:5432/postgres
